# Beszel agent configuration.
#
# Get KEY / TOKEN / HUB_URL from your Beszel hub when you add this machine
# ("Add System" in the hub UI). The agent will not connect until these are set.
KEY=
TOKEN=
HUB_URL=

# macOS SMC temperature support (set automatically by setup.sh).
# smctemp must be reachable at this absolute path — launchd's PATH does NOT
# include /usr/local/bin, so a bare "smctemp" would not be found.
SMCTEMP_PATH=/usr/local/bin/smctemp

# Sensor whose value drives the temperature shown in the All Systems table.
# Options exposed by this build: CPU, GPU.
PRIMARY_SENSOR=CPU
